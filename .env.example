# ClassGuard Environment Configuration

# Central Express API Port
PORT=4000

# Central MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/classguard

# JWT Authentication Secret Key
JWT_SECRET=classguard-academic-jwt-secret-2026

# Central API URL for Desktop Electron Client
CENTRAL_API_URL=http://localhost:4000/api

# CORS Allowed Origin
CORS_ORIGIN=*

# Environment ('development' | 'production')
NODE_ENV=development
